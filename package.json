{
  "name": "openflow",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source desktop voice transcription and speech playback",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laisyio/openflow.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.8.0"
  },
  "packageManager": "npm@10.9.8",
  "type": "module",
  "scripts": {
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/*.test.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "check": "npm run build",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo test --workspace",
    "audit:dependencies": "npm audit --audit-level=high",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
